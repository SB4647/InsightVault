# Production is intentionally disabled in source control. Enable only after review and a GitHub Environment approval.
environment                      = "production"
enable_production_infrastructure = false
enable_nat_gateway               = false
# database_final_snapshot_identifier = "insightvault-production-final-20261012"

# A real production configuration must provide immutable ECR image digests, exact Secrets Manager ARNs,
# an existing ACM certificate ARN, a globally unique bucket name, and a unique final database snapshot name.
# Never place secret values here.
